<Project Sdk="Microsoft.NET.Sdk">
  <!-- Micro-benchmarks of the engine assembly, run in Release from this folder: dotnet run -c Release.
       Kept out of the engine solution, so the test gate neither builds nor restores it. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <OutputPath>$(MSBuildThisFileDirectory)../../.cache/engine/bin/$(MSBuildProjectName)/</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" Version="0.15.2" />
    <PackageReference Include="Microsoft.ML.Tokenizers.Data.O200kBase" Version="2.0.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../FrenchExDev.OPumper2.Engine/FrenchExDev.OPumper2.Engine.csproj" />
  </ItemGroup>
</Project>
